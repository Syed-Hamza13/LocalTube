# The CI helper scripts run on an Ubuntu runner; a stray CR there breaks `bash`.
*.sh text eol=lf
*.yml text eol=lf
*.kts text eol=lf
*.toml text eol=lf

# The yt-dlp zipimport has a shebang on purpose and binary payload after it; never let git
# normalise line endings into a corrupt archive.
app/src/main/res/raw/ytdlp binary
